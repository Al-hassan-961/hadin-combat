# Use the compiled C++ core (ONNX Runtime) when available.
# If false or unavailable, the pure-Python pipeline takes over automatically:
#   pose = MediaPipe → OpenCV motion fallback;  opponent/style/co-evolution = engine.py
USE_CPP_CORE=true

# If the C++ core is unavailable (build failed / missing), fall back to the
# pure-Python pose pipeline (MediaPipe, then OpenCV motion).
FALLBACK_TO_PYTHON=true

# Redis for caching session state and athlete profiles.
REDIS_URL=redis://127.0.0.1:6379/0

# Model paths (ONNX). Leave unset to use the built-in defaults under models/.
POSE_MODEL_PATH=models/pose.onnx
STYLE_ENCODER_PATH=models/style_encoder.onnx
OPPONENT_GENERATOR_PATH=models/opponent_generator.onnx
COEVOLUTION_PATH=models/coevolution.onnx

# Server settings
HOST=0.0.0.0
PORT=8000

# Optional: amplitude scaling of the opponent adaptation (0.0 = gentle, 1.0 = aggressive)
OPPONENT_ADAPTATION=0.6
